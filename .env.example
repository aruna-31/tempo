# Application Configuration
APP_NAME="Classroom Temporal Behaviour Analytics API"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Mandatory PostgreSQL Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# Or: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tempo_db

# Security / JWT Configuration
# Generate a secure secret using: openssl rand -hex 32
JWT_SECRET_KEY=change_this_to_a_very_secure_random_secret_key_in_production_1234567890
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Faculty Domain Restriction
ALLOWED_EMAIL_DOMAIN=klu.ac.in

# File Storage Configuration
UPLOAD_DIR=./uploads/videos
MAX_UPLOAD_SIZE_BYTES=1073741824 # 1 GB
